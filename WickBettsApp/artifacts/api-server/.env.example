# API server runtime
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Database (local Postgres now; Railway Postgres later if desired)
DATABASE_URL=postgresql://postgres:password@localhost:5432/wickbetts

# Clerk (required for authenticated routes)
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx

# Canonical app origin used for Stripe redirects and CORS allowlist
APP_ORIGIN=http://localhost:3000

# Optional CORS controls
# Comma-separated literal origins in addition to localhost/Replit patterns
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set to false to disable legacy Replit domain allowances
CORS_ALLOW_REPLIT_ORIGINS=true

# Session HMAC secret for mobile token signing
SESSION_SECRET=replace-with-a-long-random-secret

# Stripe (optional; required for billing flows)
# These are public runtime IDs used for checkout and should stay easy to maintain.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx
STRIPE_PRICE_SIGNALS=prod_V3mioMmtHqjdt
STRIPE_PRICE_MENTORSHIP=prod_V3mjRfgXHyelFR
STRIPE_PRICE_MEMBERSHIP=prod_V3mi01VwWX6sA0

# Optional AI admin features
OPENAI_API_KEY=

# Backward-compatible fallback only. Prefer APP_ORIGIN.
REPLIT_DEV_DOMAIN=
