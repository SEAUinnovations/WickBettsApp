# Required by vite.config.ts
PORT=3000
BASE_PATH=/

# Clerk web client key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxx

# Optional API origin override. Leave empty for same-origin (/api) calls.
# Example: https://app.example.com
VITE_API_ORIGIN=

# Optional: only needed in production when routing Clerk through your API
# Example: https://app.example.com/api/__clerk
VITE_CLERK_PROXY_URL=
