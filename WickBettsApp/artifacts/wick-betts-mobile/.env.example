# Clerk key for Expo app
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxx

# Preferred API origin for native/EAS builds (no trailing slash)
EXPO_PUBLIC_API_URL=http://localhost:8080

# Optional fallback for environments that inject only a hostname
EXPO_PUBLIC_DOMAIN=

# Optional: explicit Clerk proxy URL (production only)
# Example: https://app.example.com/api/__clerk
EXPO_PUBLIC_CLERK_PROXY_URL=

# Optional metadata used by some Replit-oriented tooling
EXPO_PUBLIC_REPL_ID=

# Optional local port for `expo start`
PORT=8081
