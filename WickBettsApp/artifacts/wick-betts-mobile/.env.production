# Production env for `expo export --platform web` (used by build:web / the
# Cloudflare Worker deploy). Expo automatically prefers this file over plain
# `.env` when building in production mode (which `expo export` does by
# default), so this is what actually ships to wickbetts.com.
#
# EXPO_PUBLIC_API_URL is intentionally left EMPTY here. On web, an empty
# value makes lib/apiUrl.ts fall back to a relative origin ('') instead of an
# absolute URL — so the app calls same-origin `/api/...`, which the deployed
# Cloudflare Worker (see public/_worker.js) transparently proxies to Railway.
# Setting this to an absolute URL (e.g. the http://localhost:8080 used for
# local dev in .env) would get baked into the production bundle and break
# every API call on the live site — every fetch would try to hit localhost
# from the user's browser.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsud2lja2JldHRzLmNvbSQ
EXPO_PUBLIC_API_URL=
